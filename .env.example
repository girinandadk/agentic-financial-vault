# FinSentry Environment Configuration

# Local Ollama / VM Studio Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=4096

# Gemini API Fallback (set your API key here for direct cloud fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vault paths (default: ./vault_drop and ./vault_output)
# FINSENTRY_VAULT_DROP=/mnt/vault_drop
# FINSENTRY_VAULT_OUTPUT=/mnt/vault_output
